# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real credentials.

# Supabase — Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 (Phase 8 — admin real-time analytics widget).
# Leave blank until that phase; not required for the admin CRUD panel.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Webmaster tool ownership verification (all free, optional). Each renders
# its <meta> tag only once set — get the code from the "HTML tag" method on
# each service's site-verification page.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AHREFS_SITE_VERIFICATION=
